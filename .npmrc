# Makes the `engines.node` range in package.json a hard install error rather
# than a warning. Without this, npm only prints a notice and installs anyway,
# which is exactly how the Node version used locally silently drifted away
# from the one Vercel ran and produced the ERR_REQUIRE_ESM outage: the jsdom
# dependency graph (@exodus/bytes, parse5, @asamuzakjp/*) is CommonJS code
# requiring ESM-only packages, which only works on Node builds that support
# unflagged `require(esm)`.
engine-strict=true
