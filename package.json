{
  "name": "hubzero",
  "version": "3.2.1",
  "description": "The public HubZero site and the Studio CMS that publishes it, in one Next.js application.",
  "keywords": [
    "hubzero",
    "nextjs",
    "cms",
    "studio"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/HubZeroHQ/hubzero.git"
  },
  "author": "HubZero",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "perf:http": "tsx scripts/performance/http-distribution.ts",
    "perf:m32": "tsx --env-file-if-exists=.env.local scripts/performance/m32-query-amplification.ts",
    "perf:regression": "tsx --env-file-if-exists=.env.local scripts/performance/m32-regression.ts",
    "seed:perf": "tsx scripts/seed-performance-environment.ts",
    "bootstrap:dev-admin": "tsx --env-file=.env.local scripts/bootstrap-dev-admin.ts",
    "create:head-admin": "tsx --env-file=.env.local scripts/create-head-admin.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@auth/mongodb-adapter": "^3.10.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.12.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@tiptap/core": "^3.27.4",
    "@tiptap/react": "^3.27.4",
    "@tiptap/starter-kit": "^3.27.4",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.545.0",
    "mammoth": "^1.12.0",
    "mongodb": "^6.20.0",
    "next": "15.5.22",
    "next-auth": "5.0.0-beta.32",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanitize-html": "2.17.6",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sanitize-html": "2.16.1",
    "eslint": "^9.38.0",
    "eslint-config-next": "15.5.22",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "^16.2.4",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.21",
    "sharp": "0.35.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,jsx,mjs,json,css,md}": [
      "prettier --write"
    ]
  }
}
